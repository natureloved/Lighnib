{"description":"Lighnib — Small Lightning payments, locked. Wallet-as-key for local commerce (Dakar Bitcoin Hack 2026).","devDependencies":{"@types/node":"^26.6.6","concurrently":"^9.1.2","tsx":"^4.20.6","typescript":"^5.9.3"},"license":"MIT","name":"lighnib","private":true,"scripts":{"build":"npm run build --workspaces --if-present","dev":"concurrently \"npm run dev --workspace=@lighnib/api\" \"npm run dev --workspace=@lighnib/web\"","dev:api":"npm run dev --workspace=@lighnib/api","dev:web":"npm run dev --workspace=@lighnib/web","test":"tsx --test tests/*.test.ts","typecheck":"tsc -b"},"version":"0.1.0","workspaces":["apps/*","packages/*"]}